FROM node:22-alpine AS dependencies
RUN apk add --no-cache libc6-compat
WORKDIR /home/app
COPY package.json ./
COPY package-lock.json ./
RUN npm i --force

FROM node:22-alpine AS builder
WORKDIR /home/app

COPY --from=dependencies /home/app/node_modules ./node_modules
COPY . .
ENV NEXT_TELEMETRY_DISABLED 1
RUN npm run build:prod

FROM node:22-slim AS runner

WORKDIR /home/app
ENV NEXT_TELEMETRY_DISABLED 1
ENV TZ="Etc/GMT+6"
ENV NODE_ENV=production
ENV ENVIRONMENT=production

RUN apt-get update \
	&& apt-get install -y --no-install-recommends ca-certificates \
	&& rm -rf /var/lib/apt/lists/*

# Copiar archivos de la aplicación
COPY --from=builder /home/app/public /home/app/standalone/public
COPY --from=builder /home/app/.next/standalone ./standalone
COPY --from=builder /home/app/.next/static /home/app/standalone/.next/static

# Copiar script de carga de secrets de AWS
COPY --from=builder /home/app/scripts/load-aws-secrets.js ./scripts/load-aws-secrets.js
RUN chmod +x /home/app/scripts/load-aws-secrets.js

# Instalar solo la dependencia necesaria para el script (npm resuelve todas las transitivas)
RUN npm install --prefix /home/app @aws-sdk/client-secrets-manager --no-save

ARG CERT_FILE=certs/certnew.crt
COPY ${CERT_FILE} /usr/local/share/ca-certificates/gateway-ca.crt
RUN update-ca-certificates

ENV NODE_EXTRA_CA_CERTS=/usr/local/share/ca-certificates/gateway-ca.crt

ENV HOSTNAME "0.0.0.0"

RUN chown -R node:node /home/app
USER node

# Usar script de AWS que carga secrets antes de iniciar el servidor
CMD ["node", "./scripts/load-aws-secrets.js"]
